         exact Config.ofError_erase_eq he⟩
  | call_intrinsic_retattr_err ha hc hna hi hb hret =>
    simp only [Instruction.choiceFreeSyn, Bool.and_eq_true] at hcf
    obtain ⟨⟨hcal, hargs⟩, hbund⟩ := hcf
    obtain ⟨f, rfl, hnalloc, hnspec⟩ := callee_of_choiceFree hcal
    cases EvalCallee.direct_eq hc
    obtain ⟨o, o', hi⟩ := hi
    simp only [MachineState.allowLibcallsFor] at hi
    have ha' : _ = _ := ha.exec_agrees hargs o
    have hb' : _ = _ := hb.exec_agrees (bundlesChoiceFree_ite _ _ hbund) o'
    simp only [beq_iff_eq] at hb'
    exact ⟨o, by simp only [execInstr]; rw [ha']; simp [execCallee, hnalloc, specLoadOracleCall?_eq_none hnspec, hi, hb', hret]⟩
  | call_intrinsic_err ha hc hna hi =>
    simp only [Instruction.choiceFreeSyn, Bool.and_eq_true] at hcf
    obtain ⟨⟨hcal, hargs⟩, hbund⟩ := hcf
    obtain ⟨f, rfl, hnalloc, hnspec⟩ := callee_of_choiceFree hcal
    cases EvalCallee.direct_eq hc
    obtain ⟨o, hi⟩ := hi
    simp only [MachineState.allowLibcallsFor] at hi
    have ha' : _ = _ := ha.exec_agrees hargs o
    exact ⟨o, by simp only [execInstr]; rw [ha']; simp [execCallee, hnalloc, specLoadOracleCall?_eq_none hnspec, hi]⟩
  | call_user_ok ha hc hna hnone hfn hdepth hmk =>
    simp only [Instruction.choiceFreeSyn, Bool.and_eq_true] at hcf
    obtain ⟨⟨hcal, hargs⟩, hbund⟩ := hcf
    obtain ⟨f, rfl, hnalloc, hnspec⟩ := callee_of_choiceFree hcal
    cases EvalCallee.direct_eq hc
    have ha' : _ = _ := ha.exec_agrees hargs default
    simp [MachineState.allowLibcallsFor, hfn] at hnone
    simp only [tailHidden] at hmk
    exact ⟨default, by simp only [execInstr]; rw [ha']; simp [execCallee, hnalloc, specLoadOracleCall?_eq_none hnspec,
      hnone, hfn, depth_ok hdepth, hmk]⟩
  | call_user_entry_err ha hc hna hnone hfn hdepth hmk =>
    simp only [Instruction.choiceFreeSyn, Bool.and_eq_true] at hcf
    obtain ⟨⟨hcal, hargs⟩, hbund⟩ := hcf
    obtain ⟨f, rfl, hnalloc, hnspec⟩ := callee_of_choiceFree hcal
    cases EvalCallee.direct_eq hc
    have ha' : _ = _ := ha.exec_agrees hargs default
    simp [MachineState.allowLibcallsFor, hfn] at hnone
    simp only [tailHidden] at hmk
    exact ⟨default, by simp only [execInstr]; rw [ha']; simp [execCallee, hnalloc, specLoadOracleCall?_eq_none hnspec,
      hnone, hfn, depth_ok hdepth, hmk]⟩
  | call_user_overflow ha hc hna hnone hfn hd1 hd2 =>
    simp only [Instruction.choiceFreeSyn, Bool.and_eq_true] at hcf
    obtain ⟨⟨hcal, hargs⟩, hbund⟩ := hcf
    obtain ⟨f, rfl, hnalloc, hnspec⟩ := callee_of_choiceFree hcal
    cases EvalCallee.direct_eq hc
    have ha' : _ = _ := ha.exec_agrees hargs default
    simp [MachineState.allowLibcallsFor, hfn] at hnone
    exact ⟨default, by simp only [execInstr]; rw [ha']; simp [execCallee, hnalloc, specLoadOracleCall?_eq_none hnspec,
      hnone, hfn, depth_over hd1 hd2]⟩
  | call_spec_oracle_ok ha hc hna hs =>
    simp only [Instruction.choiceFreeSyn, Bool.and_eq_true] at hcf
    obtain ⟨⟨hcal, hargs⟩, hbund⟩ := hcf
    obtain ⟨f, rfl, hnalloc, hnspec⟩ := callee_of_choiceFree hcal
    cases EvalCallee.direct_eq hc; rw [specLoadOracleCall?_eq_none hnspec] at hs; cases hs
  | call_spec_oracle_entry_err ha hc hna hs =>
    simp only [Instruction.choiceFreeSyn, Bool.and_eq_true] at hcf
    obtain ⟨⟨hcal, hargs⟩, hbund⟩ := hcf
    obtain ⟨f, rfl, hnalloc, hnspec⟩ := callee_of_choiceFree hcal
    cases EvalCallee.direct_eq hc; rw [specLoadOracleCall?_eq_none hnspec] at hs; cases hs
  | call_spec_oracle_overflow ha hc hna hs =>
    simp only [Instruction.choiceFreeSyn, Bool.and_eq_true] at hcf
    obtain ⟨⟨hcal, hargs⟩, hbund⟩ := hcf
    obtain ⟨f, rfl, hnalloc, hnspec⟩ := callee_of_choiceFree hcal
    cases EvalCallee.direct_eq hc; rw [specLoadOracleCall?_eq_none hnspec] at hs; cases hs
  | call_external_err ha hc hna hnone hfn =>
    simp only [Instruction.choiceFreeSyn, Bool.and_eq_true] at hcf
    obtain ⟨⟨hcal, hargs⟩, hbund⟩ := hcf
    obtain ⟨f, rfl, hnalloc, hnspec⟩ := callee_of_choiceFree hcal
    cases EvalCallee.direct_eq hc
    have ha' : _ = _ := ha.exec_agrees hargs default
    simp [MachineState.allowLibcallsFor, hfn] at hnone
    exact ⟨default, by simp only [execInstr]; rw [ha']; simp [execCallee, hnalloc, specLoadOracleCall?_eq_none hnspec,
      hnone, hfn]⟩


/-! ## Phis, jumps, returns, terminators -/

/-- Phi incoming values without choices and phis without fast-math flags (whose input handling may
consult the oracle, once per phi). -/
def phiCodeChoiceFree : Code → Bool
  | [] => true
  | (_, .phi _ fmf incs _) :: rest =>
    !fmf.any && incs.all (fun (e, _) => e.choiceFree) && phiCodeChoiceFree rest
  | _ :: rest => phiCodeChoiceFree rest

theorem findBlock?_mem {d : Definition} {b : BlockId} {blk : Block}
    (h : d.findBlock? b = some blk) : blk ∈ d.blocks := by
  unfold Definition.findBlock? at h
  exact List.mem_of_find?_eq_some h

/-- Every phi of the function is choice-free (the block a branch reaches is not known
statically). -/
def _root_.LeanNanoLlvm.AST.Definition.phisChoiceFree (d : Definition) : Bool :=
  d.blocks.all fun b => phiCodeChoiceFree b.code

/-- A terminator whose operands take no choice (`indirectbr` is excluded: the relation lets it jump
to any listed block with the target's address, the interpreter to the first). -/
def _root_.LeanNanoLlvm.AST.Terminator.choiceFreeSyn : Terminator → Bool
  | .ret (_, e) | .condBr e _ _ | .switch _ e _ _ => e.choiceFree
  | .indirectBr .. => false
  | _ => true

theorem applyInputFMFExec_noFMF {fmf : FastMathFlags} (h : fmf.any = false) (ty v o) :
    applyInputFMFExec fmf ty v o = .ok (v, o) := by
  unfold applyInputFMFExec; rw [h]; rfl

theorem EvalPhis.exec_agrees {dl cfg regs predId mem code r}
    (h : EvalPhis dl cfg regs predId mem code r) (hcf : phiCodeChoiceFree code = true) (o : OracleState) :
    ResAgrees o r (execPhis dl cfg regs predId mem code o) := by
  cases h with
  | nil => rfl
  | cons_ok hf he hfmf ha hr =>
    simp only [phiCodeChoiceFree, Bool.and_eq_true, Bool.not_eq_true'] at hcf
    obtain ⟨⟨hnf, hincs⟩, hrest⟩ := hcf
    have hecf : _ := List.all_eq_true.mp hincs _ (List.mem_of_find?_eq_some hf)
    have he' := he.exec_ok hecf o
    obtain ⟨o1, o2, hfmf⟩ := hfmf
    rw [applyInputFMFExec_noFMF hnf] at hfmf; cases hfmf
    have hr' := EvalPhis.exec_agrees hr hrest o
    simp only [ResAgrees] at hr' ⊢
    simp [execPhis, hf, he', applyInputFMFExec_noFMF hnf, ha, hr']
  | cons_void_err => apply ResAgrees.of_static; simp [execPhis]
  | cons_missing_pred hf => apply ResAgrees.of_static; simp [execPhis, hf]
  | cons_exp_err hf he =>
    simp only [phiCodeChoiceFree, Bool.and_eq_true, Bool.not_eq_true'] at hcf
    have hecf : _ := List.all_eq_true.mp hcf.1.2 _ (List.mem_of_find?_eq_some hf)
    obtain ⟨e', hx, he'⟩ := he.exec_err hecf o
    exact ⟨e', by simp [execPhis, hf, hx], he'⟩
  | cons_fmf_err hf he hfmf =>
    simp only [phiCodeChoiceFree, Bool.and_eq_true, Bool.not_eq_true'] at hcf
    obtain ⟨o1, hfmf⟩ := hfmf
    rw [applyInputFMFExec_noFMF hcf.1.1] at hfmf; cases hfmf
  | cons_md_err hf he hfmf ha =>
    simp only [phiCodeChoiceFree, Bool.and_eq_true, Bool.not_eq_true'] at hcf
    obtain ⟨⟨hnf, hincs⟩, hrest⟩ := hcf
    have hecf : _ := List.all_eq_true.mp hincs _ (List.mem_of_find?_eq_some hf)
    have he' := he.exec_ok hecf o
    obtain ⟨o1, o2, hfmf⟩ := hfmf
    rw [applyInputFMFExec_noFMF hnf] at hfmf; cases hfmf
    exact ⟨_, by simp [execPhis, hf, he', applyInputFMFExec_noFMF hnf, ha], rfl⟩
  | cons_tail_err hf he hfmf ha hr =>
    simp only [phiCodeChoiceFree, Bool.and_eq_true, Bool.not_eq_true'] at hcf
    obtain ⟨⟨hnf, hincs⟩, hrest⟩ := hcf
    have hecf : _ := List.all_eq_true.mp hincs _ (List.mem_of_find?_eq_some hf)
    have he' := he.exec_ok hecf o
    obtain ⟨o1, o2, hfmf⟩ := hfmf
    rw [applyInputFMFExec_noFMF hnf] at hfmf; cases hfmf
    have hr' := EvalPhis.exec_agrees hr hrest o
    simp only [ResAgrees] at hr'
    obtain ⟨e', hx, he''⟩ := hr'
    exact ⟨e', by simp [execPhis, hf, he', applyInputFMFExec_noFMF hnf, ha, hx], he''⟩
  | cons_nonphi_err hne =>
    rename_i iid instr _ _
    apply ResAgrees.of_static
    cases instr with
    | phi a b c d => exact absurd rfl (hne a b c d)
    | _ => simp [execPhis]

theorem phiCodeChoiceFree_of_split {code phis body} (h : phiCodeChoiceFree code = true)
    (hs : splitPhis code = (phis, body)) : phiCodeChoiceFree phis = true := by
  induction code generalizing phis body with
  | nil => simp [splitPhis] at hs; obtain ⟨rfl, rfl⟩ := hs; rfl
  | cons hd tl ih =>
    obtain ⟨iid, instr⟩ := hd
    cases instr with
    | phi ty fmf incs md =>
      simp only [splitPhis] at hs
      cases hsp : splitPhis tl with
      | mk p b =>
        rw [hsp] at hs; simp only [Prod.mk.injEq] at hs; obtain ⟨rfl, rfl⟩ := hs
        simp only [phiCodeChoiceFree, Bool.and_eq_true] at h ⊢
        exact ⟨h.1, ih h.2 hsp⟩
    | _ => simp [splitPhis] at hs; obtain ⟨rfl, rfl⟩ := hs; rfl

theorem StepJump.exec_complete {st frame callers mem dest c'}
    (hphi : frame.defn.phisChoiceFree = true) (h : StepJump st frame callers mem dest c') (o : OracleState) :
    (execJump st frame callers mem dest o).1.erase = c'.erase := by
  cases h with
  | ok hb hs hp =>
    have hcf : phiCodeChoiceFree _ = true :=
      phiCodeChoiceFree_of_split (List.all_eq_true.mp hphi _ (findBlock?_mem hb)) hs
    have hp' : _ = _ := hp.exec_agrees hcf o
    simp [execJump, hb, hs, hp']
  | phi_err hb hs hp =>
    have hcf : phiCodeChoiceFree _ = true :=
      phiCodeChoiceFree_of_split (List.all_eq_true.mp hphi _ (findBlock?_mem hb)) hs
    obtain ⟨e', hx, he⟩ := hp.exec_agrees hcf o
    simp only [execJump, hb, hs, hx]
    exact Config.ofError_erase_eq he
  | missing_block hb => simp [execJump, hb, Config.erase]

theorem StepRet.exec_complete {st frame callers retTy retVal m1 c'}
    (h : StepRet st frame callers retTy retVal m1 c') :
    (execRet st frame callers retTy retVal m1).erase = c'.erase := by
  cases h with
  | top_ok hc ha => subst hc; unfold execRet; simp only [ha]
  | call_ok hc ha hrd hnr hf =>
    subst hc; unfold execRet; simp only [ha, hrd, hnr, hf, Bool.false_eq_true, ↓reduceIte]; rfl
  | noreturn_ub hc ha hrd hnr =>
    subst hc; unfold execRet; simp only [ha, hrd, hnr, ↓reduceIte]; rfl
  | callee_attr_err ha => unfold execRet; simp only [ha]
  | caller_attr_err hc ha hrd hnr hf =>
    subst hc; unfold execRet; simp only [ha, hrd, hnr, hf, Bool.false_eq_true, ↓reduceIte]
  | missing_dest hc ha hrd => subst hc; unfold execRet; simp only [ha, hrd]; rfl

theorem StepTerm.exec_complete {st frame callers tid term c'}
    (hcf : term.choiceFreeSyn = true) (hphi : frame.defn.phisChoiceFree = true)
    (h : StepTerm st frame callers tid term c') :
    ∃ o, (execTerm st frame callers tid term o).1.erase = c'.erase := by
  cases h with
  | retVoid_ok hty hr =>
    exact ⟨default, by simp only [execTerm, hty, ↓reduceIte]; exact StepRet.exec_complete hr⟩
  | retVoid_ty_err hty => exact ⟨default, by simp only [execTerm]; rw [if_neg hty]; rfl⟩
  | ret_ok hty he hr =>
    simp only [Terminator.choiceFreeSyn] at hcf
    exact ⟨default, by
      simp only [execTerm, hty, ↓reduceIte, he.exec_ok hcf default]; exact StepRet.exec_complete hr⟩
  | ret_exp_err hty he =>
    simp only [Terminator.choiceFreeSyn] at hcf
    obtain ⟨e', hx, he'⟩ := he.exec_err hcf default
    exact ⟨default, by simp only [execTerm, hty, if_true, hx]; exact Config.ofError_erase_eq he'⟩
  | ret_ty_err hty => exact ⟨default, by simp only [execTerm]; rw [if_neg hty]; rfl⟩
  | br_step hj => exact ⟨default, by simp only [execTerm]; exact StepJump.exec_complete hphi hj default⟩
  | condBr_ok he hj =>
    simp only [Terminator.choiceFreeSyn] at hcf
    exact ⟨default, by simp only [execTerm, he.exec_ok hcf default]; exact StepJump.exec_complete hphi hj default⟩
  | condBr_poison he =>
    simp only [Terminator.choiceFreeSyn] at hcf
    exact ⟨default, by simp [execTerm, he.exec_ok hcf default, Config.erase]⟩
  | condBr_err he =>
    simp only [Terminator.choiceFreeSyn] at hcf
    obtain ⟨e', hx, he'⟩ := he.exec_err hcf default
    exact ⟨default, by simp only [execTerm, hx]; exact Config.ofError_erase_eq he'⟩
  | condBr_nonbool he hne =>
    simp only [Terminator.choiceFreeSyn] at hcf
    rename_i v _ _
    refine ⟨default, ?_⟩
    have he' := he.exec_ok hcf default
    cases v <;> simp_all [execTerm, Config.erase]
    all_goals first | (rename_i w _; rcases w with _ | _ | w <;> simp_all) | skip
  | switch_ok he hj =>
    simp only [Terminator.choiceFreeSyn] at hcf
    exact ⟨default, by simp only [execTerm, he.exec_ok hcf default]; exact StepJump.exec_complete hphi hj default⟩
  | switch_poison he =>
    simp only [Terminator.choiceFreeSyn] at hcf
    exact ⟨default, by simp [execTerm, he.exec_ok hcf default, Config.erase]⟩
  | switch_err he =>
    simp only [Terminator.choiceFreeSyn] at hcf
    obtain ⟨e', hx, he'⟩ := he.exec_err hcf default
    exact ⟨default, by simp only [execTerm, hx]; exact Config.ofError_erase_eq he'⟩
  | switch_nonint he hne =>
    simp only [Terminator.choiceFreeSyn] at hcf
    rename_i v _ _
    refine ⟨default, ?_⟩
    have he' := he.exec_ok hcf default
    cases v <;> simp_all [execTerm, Config.erase]
  | indirectBr_ok => simp [Terminator.choiceFreeSyn] at hcf
  | indirectBr_poison => simp [Terminator.choiceFreeSyn] at hcf
  | indirectBr_invalid => simp [Terminator.choiceFreeSyn] at hcf
  | indirectBr_err => simp [Terminator.choiceFreeSyn] at hcf
  | indirectBr_nonptr => simp [Terminator.choiceFreeSyn] at hcf
  | unreachable_ub => exact ⟨default, by simp [execTerm, Config.erase]⟩


/-! ## Steps -/

/-- The operand of a `freeze` has no poison (when it evaluates; then `freeze` makes no choice). -/
def freezeChoiceFree (st : MachineState) (frame : CallFrame) : Instruction → Bool
  | .freeze (ty, e) =>
    match execExp st.dataLayout st.config frame.registers st.memory ty e default with
    | .ok (v, _, _) => !v.containsPoison
    | .error _ => true
  | _ => true

/-- The next step of `c` takes no choice the interpreter's oracle does not cover: its operands are
choice-free, it allocates nothing, a `freeze` operand has no poison, the function's phis are
choice-free, and it is not an `indirectbr`. Computable, so checked by evaluation. -/
def _root_.LeanNanoLlvm.Semantics.Config.nextChoiceFree : Config → Bool
  | .running st =>
    match st.frames with
    | [] => true
    | frame :: _ =>
      frame.defn.phisChoiceFree &&
        match frame.remainingCode with
        | (_, instr) :: _ => instr.choiceFreeSyn && freezeChoiceFree st frame instr
        | [] => frame.terminator.2.choiceFreeSyn
  | _ => true

/-- **Completeness on choice-free steps**: every `Step` from a configuration whose next step is
choice-free is a step of the interpreter, under some oracle, up to error messages. -/
theorem Step.exec_complete {st : MachineState} {ev c'}
    (hcf : (Config.running st).nextChoiceFree = true) (hs : Step (.running st) ev c') :
    ∃ o, (execStep o (.running st)).1 = ev ∧ (execStep o (.running st)).2.1.erase = c'.erase := by
  cases hs with
  | empty_stack hf => exact ⟨default, by simp [execStep, hf], by simp [execStep, hf, Config.erase]⟩
  | instr hf hc hi =>
    rename_i frame callers iid instr rest
    simp only [Config.nextChoiceFree, hf, hc, Bool.and_eq_true] at hcf
    obtain ⟨_, hsyn, hfrz⟩ := hcf
    have hfz : ∀ ty e, instr = .freeze (ty, e) → ∀ v m,
        EvalExp st.dataLayout st.config frame.registers st.memory ty e (.ok (v, m)) →
        v.containsPoison = false := by
      intro ty e hinstr v m hev
      subst hinstr
      have hx := hev.exec_ok (by simpa [Instruction.choiceFreeSyn] using hsyn) default
      simp only [freezeChoiceFree, hx, Bool.not_eq_true'] at hfrz
      exact hfrz
    obtain ⟨o, h1, h2⟩ := StepInstr.exec_complete hsyn hfz hi
    exact ⟨o, by simp only [execStep, hf, hc]; exact h1, by simp only [execStep, hf, hc]; exact h2⟩
  | term hf hc ht htm =>
    simp only [Config.nextChoiceFree, hf, hc, ht, Bool.and_eq_true] at hcf
    obtain ⟨o, h⟩ := StepTerm.exec_complete hcf.2 hcf.1 htm
    exact ⟨o, by simp [execStep, hf, hc, ht], by simp only [execStep, hf, hc, ht]; exact h⟩

/-- **Determinism on choice-free steps**: if, moreover, the interpreter's step does not depend on
its oracle, it is the only step (up to error messages). -/
theorem Step.det_of_exec {st : MachineState} {ev c'}
    (hcf : (Config.running st).nextChoiceFree = true)
    (hind : ∀ o, (execStep o (.running st)).1 = (execStep default (.running st)).1 ∧
      (execStep o (.running st)).2.1.erase = (execStep default (.running st)).2.1.erase)
    (hs : Step (.running st) ev c') :
    ev = (execStep default (.running st)).1 ∧ c'.erase = (execStep default (.running st)).2.1.erase := by
  obtain ⟨o, h1, h2⟩ := Step.exec_complete hcf hs
  obtain ⟨i1, i2⟩ := hind o
  exact ⟨h1 ▸ i1, h2 ▸ i2⟩

end LeanNanoLlvm.Semantics
