import LeanNanoLlvm.Semantics.Determinism

/-! # Determinism of `StepInstr` on choice-free instructions

See `LeanNanoLlvm.Semantics.Determinism`. The regular cases of `StepInstr.exec_complete` are
generated by `scripts/gen/det_cases.py` from the rules in `Step.lean`. -/

namespace LeanNanoLlvm.Semantics

open AST

/-! ## Configurations up to error messages -/

/-- A configuration with the messages of its errors erased (no refinement observes them). -/
def Config.erase : Config → Config
  | .ub _ => .ub ""
  | .staticError _ => .staticError ""
  | .resourceError e => .resourceError e.erase
  | c => c

theorem Config.ofError_erase_eq {e e' : ExecError} (h : e'.erase = e.erase) :
    (Config.ofError e').erase = (Config.ofError e).erase := by
  cases e <;> cases e' <;> simp_all [ExecError.erase, Config.ofError, Config.erase]

/-! ## Choice-free instructions (syntactic part) -/

/-- Call arguments without choices. -/
def callArgsChoiceFree : List (LlvmType × Exp × List ValueAttr) → Bool
  | [] => true
  | (_, e, _) :: rest => e.choiceFree && callArgsChoiceFree rest

/-- Operand bundles without choices. -/
def bundlesChoiceFree : List (String × List (LlvmType × Exp)) → Bool
  | [] => true
  | (_, es) :: rest => Exp.choiceFreeList es && bundlesChoiceFree rest

/-- An instruction whose operands take no choice and which is not itself a choice
(`alloca` picks an address; `freeze` is further checked on its operand's value, see
`Config.nextChoiceFree`; a call of an allocation function picks an address too). -/
def _root_.LeanNanoLlvm.AST.Instruction.choiceFreeSyn : Instruction → Bool
  | .intBinaryOp _ _ a b | .floatBinaryOp _ _ a b | .icmp _ _ _ a b | .fcmp _ _ _ a b =>
    a.choiceFree && b.choiceFree
  | .floatUnaryOp _ _ a | .conversionOp _ _ a _ | .extractvalue _ a _ => a.choiceFree
  | .select _ _ c _ t f => c.choiceFree && t.choiceFree && f.choiceFree
  | .phi .. => true
  | .alloca .. => false
  | .load _ _ p _ _ _ _ => p.choiceFree
  | .store _ v _ p _ _ => v.choiceFree && p.choiceFree
  | .getelementptr _ _ _ p idxs => p.choiceFree && Exp.choiceFreeList idxs
  | .insertvalue _ a _ b _ | .extractelement _ a _ b | .shufflevector _ a b _ =>
    a.choiceFree && b.choiceFree
  | .insertelement _ a _ b _ c | .bitinsert _ a _ b _ c => a.choiceFree && b.choiceFree && c.choiceFree
  | .bitextract _ _ a _ b => a.choiceFree && b.choiceFree
  | .call _ _ callee args _ bundles _ _ =>
    (match callee with
      | .identifier (.global_id f) =>
        !isAllocLibcall f.toString && !strHasPrefix f.toString "llvm.speculative.load"
      | _ => false) && callArgsChoiceFree args && bundlesChoiceFree bundles
  | .freeze (_, e) => e.choiceFree

/-! ## Helpers -/

theorem EvalExp.exec_ok {dl cfg regs mem ty e v m} (h : EvalExp dl cfg regs mem ty e (.ok (v, m)))
    (hcf : e.choiceFree = true) (o : OracleState) :
    execExp dl cfg regs mem ty e o = .ok (v, m, o) := h.exec_agrees hcf o

theorem EvalExp.exec_err {dl cfg regs mem ty e err} (h : EvalExp dl cfg regs mem ty e (.error err))
    (hcf : e.choiceFree = true) (o : OracleState) :
    ∃ e', execExp dl cfg regs mem ty e o = .error e' ∧ e'.erase = err.erase := h.exec_agrees hcf o

theorem EvalExpList.exec_ok {dl cfg regs mem es vs m} (h : EvalExpList dl cfg regs mem es (.ok (vs, m)))
    (hcf : Exp.choiceFreeList es = true) (o : OracleState) :
    execExpList dl cfg regs mem es o = .ok (vs, m, o) := h.exec_agrees hcf o

theorem EvalExpList.exec_err {dl cfg regs mem es err} (h : EvalExpList dl cfg regs mem es (.error err))
    (hcf : Exp.choiceFreeList es = true) (o : OracleState) :
    ∃ e', execExpList dl cfg regs mem es o = .error e' ∧ e'.erase = err.erase := h.exec_agrees hcf o

/-- What `StepInstr.exec_complete` concludes for one rule: an oracle under which the interpreter
takes that rule's step (event and configuration up to messages). -/
def InstrCompletes (st : MachineState) (frame : CallFrame) (callers : List CallFrame)
    (iid : InstructionId) (rest : Code) (instr : Instruction) (ev : Option TraceEvent) (c' : Config) : Prop :=
  ∃ o, (execInstr st frame callers iid rest instr o).1 = ev ∧
    (execInstr st frame callers iid rest instr o).2.1.erase = c'.erase


/-! ## `freeze` of a value without poison -/

private theorem FreezeBitListRel.eq_of_concrete {cfg : SemanticsConfig} :
    ∀ {bs bs' : List MemBit}, FreezeBitListRel cfg bs bs' → bs.all MemBit.isConcrete = true → bs' = bs
  | _, _, .nil, _ => rfl
  | _, _, .cons hb hrest, h => by
    simp only [List.all_cons, Bool.and_eq_true] at h
    cases hb with
    | concrete b p => rw [FreezeBitListRel.eq_of_concrete hrest h.2]
    | poison b _ => simp [MemBit.isConcrete] at h
    | undef b _ => simp [MemBit.isConcrete] at h

mutual
/-- `freeze` keeps a value that has no poison or undefined bits. -/
theorem FreezeRel.eq_of_noPoison {dl cfg} :
    ∀ {v v' : RegisterValue}, FreezeRel dl cfg v v' → v.containsPoison = false → v' = v
  | _, _, .bv_val _ _, _ => rfl
  | _, _, .bv_poison _ _ _, h => by simp [RegisterValue.containsPoison] at h
  | _, _, .byte w bs bs' hb, h => by
    simp only [RegisterValue.containsPoison, List.any_eq_false, Bool.not_eq_true'] at h
    rw [FreezeBitListRel.eq_of_concrete hb (List.all_eq_true.mpr (fun x hx => by
      have := h x hx; cases hx' : x.isConcrete <;> simp_all))]
  | _, _, .float_val _ _, _ => rfl
  | _, _, .float_poison _ _ _, h => by simp [RegisterValue.containsPoison] at h
  | _, _, .ptr_val _ _, _ => rfl
  | _, _, .ptr_poison _ _ _, h => by simp [RegisterValue.containsPoison] at h
  | _, _, .vector _ _ _ hl, h => by
    simp only [RegisterValue.containsPoison] at h; rw [FreezeRelList.eq_of_noPoison hl h]
  | _, _, .array _ _ _ hl, h => by
    simp only [RegisterValue.containsPoison] at h; rw [FreezeRelList.eq_of_noPoison hl h]
  | _, _, .struct _ _ _ _ hl, h => by
    simp only [RegisterValue.containsPoison] at h; rw [FreezeRelList.eq_of_noPoison hl h]
  | _, _, .void, _ => rfl

theorem FreezeRelList.eq_of_noPoison {dl cfg} :
    ∀ {vs vs' : List RegisterValue}, FreezeRelList dl cfg vs vs' →
      RegisterValue.containsPoisonList vs = false → vs' = vs
  | _, _, .nil, _ => rfl
  | _, _, .cons hv hl, h => by
    simp only [RegisterValue.containsPoisonList, Bool.or_eq_false_iff] at h
    rw [FreezeRel.eq_of_noPoison hv h.1, FreezeRelList.eq_of_noPoison hl h.2]
end

private theorem mapBitsFrom_frozenBit_concrete (cfg : SemanticsConfig) (d : List (Nat × Nat)) :
    ∀ (k : Nat) (bs : List MemBit), bs.all MemBit.isConcrete = true → mapBitsFrom (frozenBit cfg d) k bs = bs
  | _, [], _ => rfl
  | k, b :: bs, h => by
    simp only [List.all_cons, Bool.and_eq_true] at h
    cases b with
    | concrete b p => simp [mapBitsFrom, frozenBit, mapBitsFrom_frozenBit_concrete cfg d (k + 1) bs h.2]
    | poison => simp [MemBit.isConcrete] at h
    | undef => simp [MemBit.isConcrete] at h

mutual
/-- The interpreter's `freeze` keeps a value that has no poison or undefined bits. -/
theorem freezeValue_of_noPoison {dl cfg} :
    ∀ (v : RegisterValue) (o : OracleState), v.containsPoison = false → (freezeValue dl cfg v o).1 = v
  | .bv w (.value _), _, _ => rfl
  | .bv w .poison, _, h => by simp [RegisterValue.containsPoison] at h
  | .byte w bs, o, h => by
    simp only [RegisterValue.containsPoison, List.any_eq_false, Bool.not_eq_true'] at h
    simp only [freezeValue, freezeByteBits]
    rw [mapBitsFrom_frozenBit_concrete cfg _ 0 bs (List.all_eq_true.mpr (fun x hx => by
      have := h x hx; cases hx' : x.isConcrete <;> simp_all))]
  | .float _ (.value _), _, _ => rfl
  | .float _ .poison, _, h => by simp [RegisterValue.containsPoison] at h
  | .ptr _ (.value _), _, _ => rfl
  | .ptr _ .poison, _, h => by simp [RegisterValue.containsPoison] at h
  | .vector _ es, o, h => by
    simp only [RegisterValue.containsPoison] at h
    simp only [freezeValue]; rw [freezeValueList_of_noPoison es o h]
  | .array _ es, o, h => by
    simp only [RegisterValue.containsPoison] at h
    simp only [freezeValue]; rw [freezeValueList_of_noPoison es o h]
  | .struct _ _ fs, o, h => by
    simp only [RegisterValue.containsPoison] at h
    simp only [freezeValue]; rw [freezeValueList_of_noPoison fs o h]
  | .void, _, _ => rfl

theorem freezeValueList_of_noPoison {dl cfg} :
    ∀ (vs : List RegisterValue) (o : OracleState), RegisterValue.containsPoisonList vs = false →
      (freezeValueList dl cfg vs o).1 = vs
  | [], _, _ => rfl
  | v :: vs, o, h => by
    simp only [RegisterValue.containsPoisonList, Bool.or_eq_false_iff] at h
    simp only [freezeValueList]
    rw [freezeValue_of_noPoison v o h.1, freezeValueList_of_noPoison vs _ h.2]
end


/-! ## Call arguments, callee, operand bundles -/

/-- `EvalExp.exec_agrees` for call arguments. -/
theorem EvalCallArgs.exec_agrees {dl cfg regs mem args r}
    (h : EvalCallArgs dl cfg regs mem args r) (hcf : callArgsChoiceFree args = true) (o : OracleState) :
    ResAgrees o r (execCallArgs dl cfg regs mem args o) := by
  cases h with
  | nil => rfl
  | cons_ok he ha hr =>
    simp only [callArgsChoiceFree, Bool.and_eq_true] at hcf
    have h1 := he.exec_ok hcf.1 o
    have h2 := EvalCallArgs.exec_agrees hr hcf.2 o
    simp only [ResAgrees] at h2 ⊢
    simp [execCallArgs, h1, ha, h2]
  | cons_exp_err he =>
    simp only [callArgsChoiceFree, Bool.and_eq_true] at hcf
    obtain ⟨e', hx, he'⟩ := he.exec_err hcf.1 o
    exact ⟨e', by simp [execCallArgs, hx], he'⟩
  | cons_attr_err he ha =>
    simp only [callArgsChoiceFree, Bool.and_eq_true] at hcf
    have h1 := he.exec_ok hcf.1 o
    exact ⟨_, by simp [execCallArgs, h1, ha], rfl⟩
  | cons_tail_err he ha hr =>
    simp only [callArgsChoiceFree, Bool.and_eq_true] at hcf
    have h1 := he.exec_ok hcf.1 o
    have h2 := EvalCallArgs.exec_agrees hr hcf.2 o
    simp only [ResAgrees] at h2
    obtain ⟨e', hx, he'⟩ := h2
    exact ⟨e', by simp [execCallArgs, h1, ha, hx], he'⟩

/-- A direct callee is itself, in both semantics. -/
theorem EvalCallee.direct_eq {dl cfg regs mem f r}
    (h : EvalCallee dl cfg regs mem (.identifier (.global_id f)) r) : r = .ok (f, mem) := by
  cases h with
  | direct => rfl
  | indirect_ok hne _ _ => exact absurd rfl (hne f)
  | indirect_exp_err hne _ => exact absurd rfl (hne f)
  | indirect_poison hne _ => exact absurd rfl (hne f)
  | indirect_bad_addr hne _ _ => exact absurd rfl (hne f)
  | indirect_nonptr hne _ _ => exact absurd rfl (hne f)

/-- Results of a memory-only evaluation agree (as `ResAgrees`). -/
def ResAgreesM (o : OracleState) :
    Except ExecError MemoryState → Except ExecError (MemoryState × OracleState) → Prop
  | .ok m, x => x = .ok (m, o)
  | .error e, x => ∃ e', x = .error e' ∧ e'.erase = e.erase

/-- `EvalExp.exec_agrees` for operand bundles. -/
theorem EvalAssumeBundles.exec_agrees {dl cfg regs mem bs r}
    (h : EvalAssumeBundles dl cfg regs mem bs r) (hcf : bundlesChoiceFree bs = true) (o : OracleState) :
    ResAgreesM o r (execAssumeBundles dl cfg regs mem bs o) := by
  cases h with
  | nil => rfl
  | cons_skip ht hr =>
    simp only [bundlesChoiceFree, Bool.and_eq_true] at hcf
    have := EvalAssumeBundles.exec_agrees hr hcf.2 o
    simpa [execAssumeBundles, ht] using this
  | cons_ok ht he hc hr =>
    simp only [bundlesChoiceFree, Bool.and_eq_true] at hcf
    have h1 := he.exec_ok hcf.1 o
    have := EvalAssumeBundles.exec_agrees hr hcf.2 o
    simpa [execAssumeBundles, ht, h1, hc] using this
  | cons_eval_err ht he =>
    simp only [bundlesChoiceFree, Bool.and_eq_true] at hcf
    obtain ⟨e', hx, he'⟩ := he.exec_err hcf.1 o
    exact ⟨e', by simp [execAssumeBundles, ht, hx], he'⟩
  | cons_check_err ht he hc =>
    simp only [bundlesChoiceFree, Bool.and_eq_true] at hcf
    have h1 := he.exec_ok hcf.1 o
    exact ⟨_, by simp [execAssumeBundles, ht, h1, hc], rfl⟩
  | cons_tail_err ht he hc hr =>
    simp only [bundlesChoiceFree, Bool.and_eq_true] at hcf
    have h1 := he.exec_ok hcf.1 o
    have := EvalAssumeBundles.exec_agrees hr hcf.2 o
    simp only [ResAgreesM] at this
    obtain ⟨e', hx, he'⟩ := this
    exact ⟨e', by simp [execAssumeBundles, ht, h1, hc, hx], he'⟩

theorem bundlesChoiceFree_ite (c : Bool) (bs : List (String × List (LlvmType × Exp)))
    (h : bundlesChoiceFree bs = true) : bundlesChoiceFree (if c then bs else []) = true := by
  cases c <;> simp [h, bundlesChoiceFree]


theorem callee_of_choiceFree {e : Exp}
    (h : (match e with
      | .identifier (.global_id f) =>
        !isAllocLibcall f.toString && !strHasPrefix f.toString "llvm.speculative.load"
      | _ => false) = true) :
    ∃ f, e = .identifier (.global_id f) ∧ isAllocLibcall f.toString = false ∧
      strHasPrefix f.toString "llvm.speculative.load" = false := by
  cases e with
  | identifier id =>
    cases id with
    | global_id f => simp only [Bool.and_eq_true, Bool.not_eq_true'] at h; exact ⟨f, rfl, h.1, h.2⟩
    | local_id _ => simp at h
  | _ => simp at h

theorem specLoadOracleCall?_eq_none {st m fname argVals}
    (h : strHasPrefix fname "llvm.speculative.load" = false) :
    specLoadOracleCall? st m fname argVals = none := by
  simp [specLoadOracleCall?, h]

theorem depth_ok {st : MachineState}
    (h : st.config.maxStackDepth == 0 ∨ st.frames.length < st.config.maxStackDepth) :
    (st.config.maxStackDepth != 0 && st.frames.length ≥ st.config.maxStackDepth) = false := by
  rcases h with h | h
  · simp_all
  · have : ¬ (st.config.maxStackDepth ≤ st.frames.length) := by omega
    simp [this]

theorem depth_over {st : MachineState} (h1 : st.config.maxStackDepth ≠ 0)
    (h2 : st.frames.length ≥ st.config.maxStackDepth) :
    (st.config.maxStackDepth != 0 && st.frames.length ≥ st.config.maxStackDepth) = true := by
  simp_all

/-! ## Instructions -/

set_option maxHeartbeats 1600000 in
theorem StepInstr.exec_complete {st frame callers iid rest instr ev c'}
    (hcf : instr.choiceFreeSyn = true)
    (hfz : ∀ ty e, instr = .freeze (ty, e) → ∀ v m,
      EvalExp st.dataLayout st.config frame.registers st.memory ty e (.ok (v, m)) → v.containsPoison = false)
    (hi : StepInstr st frame callers iid rest instr ev c') :
    InstrCompletes st frame callers iid rest instr ev c' := by
  cases hi with
  | intBinaryOp_ok h0 h1 h2 =>
    simp only [Instruction.choiceFreeSyn, Bool.and_eq_true] at hcf
    have h0' := h0.exec_ok (by simp_all) default
    have h1' := h1.exec_ok (by simp_all) default
    exact ⟨default, by simp [execInstr, h0', h1', h2]⟩
  | intBinaryOp_e1_err h0 =>
    simp only [Instruction.choiceFreeSyn, Bool.and_eq_true] at hcf
    obtain ⟨e', h0', he⟩ := h0.exec_err (by simp_all) default
    exact ⟨default, by simp [execInstr, h0'], by simp [execInstr, h0', -Config.ofError]; exact Config.ofError_erase_eq he⟩
  | intBinaryOp_e2_err h0 h1 =>
    simp only [Instruction.choiceFreeSyn, Bool.and_eq_true] at hcf
    have h0' := h0.exec_ok (by simp_all) default
    obtain ⟨e', h1', he⟩ := h1.exec_err (by simp_all) default
    exact ⟨default, by simp [execInstr, h0', h1'], by simp [execInstr, h0', h1', -Config.ofError]; exact Config.ofError_erase_eq he⟩
  | intBinaryOp_eval_err h0 h1 h2 =>
    simp only [Instruction.choiceFreeSyn, Bool.and_eq_true] at hcf
    have h0' := h0.exec_ok (by simp_all) default
    have h1' := h1.exec_ok (by simp_all) default
    exact ⟨default, by simp [execInstr, h0', h1', h2]⟩
  | floatUnaryOp_ok h0 h1 =>
    simp only [Instruction.choiceFreeSyn, Bool.and_eq_true] at hcf
    obtain ⟨o, _, h1⟩ := h1
    have h0' := h0.exec_ok (by simp_all) o
    exact ⟨o, by simp [execInstr, h1, h0']⟩
  | floatUnaryOp_e_err h0 =>
    simp only [Instruction.choiceFreeSyn, Bool.and_eq_true] at hcf
    obtain ⟨e', h0', he⟩ := h0.exec_err (by simp_all) default
    exact ⟨default, by simp [execInstr, h0'], by simp [execInstr, h0', -Config.ofError]; exact Config.ofError_erase_eq he⟩
  | floatUnaryOp_eval_err h0 h1 =>
    simp only [Instruction.choiceFreeSyn, Bool.and_eq_true] at hcf
    obtain ⟨o, h1⟩ := h1
    have h0' := h0.exec_ok (by simp_all) o
    exact ⟨o, by simp [execInstr, h1, h0']⟩
  | floatBinaryOp_ok h0 h1 h2 =>
    simp only [Instruction.choiceFreeSyn, Bool.and_eq_true] at hcf
    obtain ⟨o, _, h2⟩ := h2
    have h0' := h0.exec_ok (by simp_all) o
    have h1' := h1.exec_ok (by simp_all) o
    exact ⟨o, by simp [execInstr, h2, h0', h1']⟩
  | floatBinaryOp_e1_err h0 =>
    simp only [Instruction.choiceFreeSyn, Bool.and_eq_true] at hcf
    obtain ⟨e', h0', he⟩ := h0.exec_err (by simp_all) default
    exact ⟨default, by simp [execInstr, h0'], by simp [execInstr, h0', -Config.ofError]; exact Config.ofError_erase_eq he⟩
  | floatBinaryOp_e2_err h0 h1 =>
    simp only [Instruction.choiceFreeSyn, Bool.and_eq_true] at hcf
    have h0' := h0.exec_ok (by simp_all) default
    obtain ⟨e', h1', he⟩ := h1.exec_err (by simp_all) default
    exact ⟨default, by simp [execInstr, h0', h1'], by simp [execInstr, h0', h1', -Config.ofError]; exact Config.ofError_erase_eq he⟩
  | floatBinaryOp_eval_err h0 h1 h2 =>
    simp only [Instruction.choiceFreeSyn, Bool.and_eq_true] at hcf
    obtain ⟨o, h2⟩ := h2
    have h0' := h0.exec_ok (by simp_all) o
    have h1' := h1.exec_ok (by simp_all) o
    exact ⟨o, by simp [execInstr, h2, h0', h1']⟩
  | icmp_ok h0 h1 h2 =>
    simp only [Instruction.choiceFreeSyn, Bool.and_eq_true] at hcf
    have h0' := h0.exec_ok (by simp_all) default
    have h1' := h1.exec_ok (by simp_all) default
    exact ⟨default, by simp [execInstr, h0', h1', h2]⟩
  | icmp_e1_err h0 =>
    simp only [Instruction.choiceFreeSyn, Bool.and_eq_true] at hcf
    obtain ⟨e', h0', he⟩ := h0.exec_err (by simp_all) default
    exact ⟨default, by simp [execInstr, h0'], by simp [execInstr, h0', -Config.ofError]; exact Config.ofError_erase_eq he⟩
  | icmp_e2_err h0 h1 =>
    simp only [Instruction.choiceFreeSyn, Bool.and_eq_true] at hcf
    have h0' := h0.exec_ok (by simp_all) default
    obtain ⟨e', h1', he⟩ := h1.exec_err (by simp_all) default
    exact ⟨default, by simp [execInstr, h0', h1'], by simp [execInstr, h0', h1', -Config.ofError]; exact Config.ofError_erase_eq he⟩
  | icmp_eval_err h0 h1 h2 =>
    simp only [Instruction.choiceFreeSyn, Bool.and_eq_true] at hcf
    have h0' := h0.exec_ok (by simp_all) default
    have h1' := h1.exec_ok (by simp_all) default
    exact ⟨default, by simp [execInstr, h0', h1', h2]⟩
  | fcmp_ok h0 h1 h2 =>
    simp only [Instruction.choiceFreeSyn, Bool.and_eq_true] at hcf
    obtain ⟨o, _, h2⟩ := h2
    have h0' := h0.exec_ok (by simp_all) o
    have h1' := h1.exec_ok (by simp_all) o
    exact ⟨o, by simp [execInstr, h2, h0', h1']⟩
  | fcmp_e1_err h0 =>
    simp only [Instruction.choiceFreeSyn, Bool.and_eq_true] at hcf
    obtain ⟨e', h0', he⟩ := h0.exec_err (by simp_all) default
    exact ⟨default, by simp [execInstr, h0'], by simp [execInstr, h0', -Config.ofError]; exact Config.ofError_erase_eq he⟩
  | fcmp_e2_err h0 h1 =>
    simp only [Instruction.choiceFreeSyn, Bool.and_eq_true] at hcf
    have h0' := h0.exec_ok (by simp_all) default
    obtain ⟨e', h1', he⟩ := h1.exec_err (by simp_all) default
    exact ⟨default, by simp [execInstr, h0', h1'], by simp [execInstr, h0', h1', -Config.ofError]; exact Config.ofError_erase_eq he⟩
  | fcmp_eval_err h0 h1 h2 =>
    simp only [Instruction.choiceFreeSyn, Bool.and_eq_true] at hcf
    obtain ⟨o, h2⟩ := h2
    have h0' := h0.exec_ok (by simp_all) o
    have h1' := h1.exec_ok (by simp_all) o
    exact ⟨o, by simp [execInstr, h2, h0', h1']⟩
  | conversionOp_ok h0 h1 =>
    simp only [Instruction.choiceFreeSyn, Bool.and_eq_true] at hcf
    obtain ⟨o, _, h1⟩ := h1
    have h0' := h0.exec_ok (by simp_all) o
    exact ⟨o, by simp [execInstr, h1, h0']⟩
  | conversionOp_e_err h0 =>
    simp only [Instruction.choiceFreeSyn, Bool.and_eq_true] at hcf
    obtain ⟨e', h0', he⟩ := h0.exec_err (by simp_all) default
    exact ⟨default, by simp [execInstr, h0'], by simp [execInstr, h0', -Config.ofError]; exact Config.ofError_erase_eq he⟩
  | conversionOp_eval_err h0 h1 =>
    simp only [Instruction.choiceFreeSyn, Bool.and_eq_true] at hcf
    obtain ⟨o, h1⟩ := h1
